#version 460 core
#extension GL_ARB_bindless_texture : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(bindless_image, rgba16f) uniform image2D cellData_Texture_in;

layout(bindless_image, rgba16f) uniform image2D cellData_Texture_out;

uniform uvec2 cell_count;

bool cellExists(ivec2 cell_coord) {
    if (cell_coord.x < 0 || cell_coord.y < 0) return false;
    if (cell_coord.x >= int(cell_count.x) || cell_coord.y >= int(cell_count.y)) return false;
    return true;
}

void main() {
    uvec2 ucell = gl_GlobalInvocationID.xy;
    if (ucell.x >= cell_count.x || ucell.y >= cell_count.y) return;

    ivec2 cell_coord = ivec2(ucell);

    vec4 cell_data = imageLoad(cellData_Texture_in, cell_coord);
    
    cell_data.x += cell_data.y;

    imageStore(cellData_Texture_out, cell_coord, cell_data);
}